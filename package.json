{
  "name": "squid",
  "private": true,
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "tsc",
    "type:generate": "npx squid-typeorm-codegen",
    "db:migrate": "npx squid-typeorm-migration apply",
    "db:reset": "docker compose down -v db && docker compose up -d db",
    "db:init": "yarn migration:clean; yarn migration:generate && yarn db:migrate",
    "migration:revert": "npx squid-typeorm-migration revert",
    "migration:generate": "npx squid-typeorm-migration generate",
    "migration:create": "npx squid-typeorm-migration create",
    "migration:clean": "rm -rf db/migrations/*",
    "codegen": "npx squid-substrate-typegen typegen.json",
    "gen:decoder": "node packages/subsquid-ink-v6-decoder/lib/cli.js",
    "gen:decoders": "node packages/subsquid-ink-v6-decoder/lib/cli.js --config src/decoders/ink-contracts.json",
    "gen:decoders:full": "bash -c 'cd packages/subsquid-ink-v6-decoder && npx tsc && cp src/cli.js lib/cli.js && cd ../.. && yarn gen:decoders && yarn build && rm -rf node_modules/@luckyweb3/subsquid-ink-v6-decoder && yarn install'",
    "processor": "node -r dotenv/config lib/main.js",
    "serve": "npx @subsquid/graphql-server"
  },
  "dependencies": {
    "@luckyweb3/subsquid-ink-v6-decoder": "file:./packages/subsquid-ink-v6-decoder",
    "@polkadot-api/ink-contracts": "^0.4.5",
    "@polkadot-api/polkadot-sdk-compat": "^2.4.1",
    "@polkadot-api/sdk-ink": "^0.6.2",
    "@polkadot-api/ws-provider": "^0.7.4",
    "@polkadot/api-contract": "^16.5.4",
    "@polkadot/types": "^16.5.4",
    "@polkadot/util": "^13.5.7",
    "@polkadot/util-crypto": "^13.5.7",
    "@subsquid/big-decimal": "^1.0.0",
    "@subsquid/graphql-server": "^4.6.0",
    "@subsquid/ss58": "^2.0.2",
    "@subsquid/substrate-processor": "^8.6.1",
    "@subsquid/substrate-runtime": "^2.0.1",
    "@subsquid/typeorm-migration": "^1.3.0",
    "@subsquid/typeorm-store": "^1.5.1",
    "dotenv": "^16.4.5",
    "pg": "8.12.0",
    "polkadot-api": "^1.23.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@subsquid/ink-typegen": "^3.1.0",
    "@subsquid/substrate-metadata-explorer": "^3.1.2",
    "@subsquid/substrate-typegen": "^8.1.0",
    "@subsquid/typeorm-codegen": "^2.0.1",
    "@types/node": "^24.9.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  },
  "resolutions": {
    "glob": "^10.5.0"
  },
  "packageManager": "yarn@4.10.3"
}
