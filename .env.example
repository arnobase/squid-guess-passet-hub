# Configuration Squid Guess Indexer
# Copiez ce fichier vers .env et ajustez les valeurs selon vos besoins

# Configuration Blockchain
RPC_URL_WS=wss://query.substrate.fi/guess-the-number-node
START_BLOCK=1888457
END_BLOCK=
FINALITY_CONFIRMATION=1

# Configuration Base de Données
DB_HOST=db
DB_PORT=5432
DB_NAME=squid_guess_indexer
DB_USER=postgres
DB_PASS=postgres

# Configuration Logs
LOG_LEVEL=info
# Valeurs possibles: error, warn, info, debug
# - error: Seulement les erreurs
# - warn: Erreurs + avertissements
# - info: Erreurs + avertissements + informations importantes (recommandé pour production)
# - debug: Tous les logs (recommandé pour développement)

# Configuration Contrats
# Contrats spécifiques (requis par l'indexeur)
GUESS_THE_NUMBER_CONTRACTS=0x987b94aaff6c60d10002d76f7ec2fe3fef837559
ERC721_CONTRACTS=0xeb3c4a6d9dd4b62eca09f87e5de151f37c02c2e7
# Liste complète des contrats ciblés (optionnelle, sinon dérivée des deux listes ci-dessus)
#TARGET_CONTRACTS=0x987b94aaff6c60d10002d76f7ec2fe3fef837559,0xeb3c4a6d9dd4b62eca09f87e5de151f37c02c2e7
# Adresses des contrats à surveiller (séparées par des virgules)
# Exemple pour plusieurs contrats: 0x1234...,0x5678...

# Configuration Environnement
NODE_ENV=production
# Valeurs possibles: development, staging, production